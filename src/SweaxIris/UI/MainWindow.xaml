<Window x:Class="SweaxIris.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SweaxIris.UI"
        xmlns:core="clr-namespace:SweaxIris.Core"
        Title="SweaxIris" Width="1060" Height="760" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Plex}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:Iris x:Name="Logo" Width="24" Height="24" ShowScale="False" Aperture="0.42"/>
                <TextBlock Text="SweaxIris" FontFamily="{StaticResource PlexSemi}" FontSize="15" Margin="10,0,0,1" VerticalAlignment="Center"/>
                <TextBlock x:Name="Tagline" Style="{StaticResource Faint}" FontSize="12.5" Margin="10,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="RecChip" CornerRadius="7" Background="{DynamicResource TallySoft}" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{DynamicResource Tally}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecChipText" Margin="7,0,0,0" FontFamily="{StaticResource PlexMedium}" FontSize="12.5" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Style="{StaticResource IconBtn}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0" ToolTip="{core:L settings}">
                    <ui:Ico Data="{StaticResource IcoGear}" Width="19" Height="19"/>
                </Button>
                <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoMin}" Width="14" Height="14" Stroke="1.3"/></Button>
                <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoMax}" Width="12" Height="12" Stroke="1.3"/></Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoClose}" Width="13" Height="13" Stroke="1.3"/></Button>
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" Margin="16,2,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="336"/>
            </Grid.ColumnDefinitions>

            <!-- viewfinder and the record deck -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Finder" CornerRadius="12" Background="{DynamicResource Viewfinder}" ClipToBounds="True" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="18"/>
                        <StackPanel x:Name="FinderEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.75">
                            <ui:Iris Width="64" Height="64" ShowScale="False" Aperture="0.12"/>
                            <TextBlock x:Name="FinderEmptyText" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#9AA3B0" FontSize="13"/>
                        </StackPanel>
                        <!-- viewfinder marks -->
                        <Path x:Name="Brackets" Stroke="#BFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" CornerRadius="6" Background="#99090B0E" Padding="9,4">
                            <TextBlock x:Name="SourceChip" Foreground="#E9ECF1" FontSize="12" FontFamily="{StaticResource PlexMedium}"/>
                        </Border>
                        <Border x:Name="FinderRec" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="14" CornerRadius="6" Background="#99090B0E" Padding="9,4" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="FinderDot" Width="8" Height="8" Fill="{DynamicResource Tally}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FinderRecText" Margin="7,0,0,0" Foreground="#E9ECF1" FontSize="12" FontFamily="{StaticResource PlexMedium}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- deck: summary · iris · timer -->
                <Grid Grid.Row="1" Margin="0,12,0,0" Height="124">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="OutSize" FontFamily="{StaticResource PlexSemi}" FontSize="16"/>
                        <TextBlock x:Name="OutLine" Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                        <TextBlock x:Name="OutLine2" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseButton" Grid.Column="0" Style="{StaticResource Btn}" Width="46" Height="46" Padding="0" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                            <ui:Ico x:Name="PauseIco" Data="{StaticResource IcoPause}" Width="20" Height="20" Stroke="2.2"/>
                        </Button>
                        <Grid x:Name="RecordHost" Grid.Column="1" Width="120" Height="120" Cursor="Hand" Background="Transparent">
                            <ui:Iris x:Name="RecordIris" Aperture="0.18"/>
                            <TextBlock x:Name="CountText" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource PlexSemi}" FontSize="34" Foreground="White" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="MicButton" Grid.Column="2" Style="{StaticResource Btn}" Width="46" Height="46" Padding="0" HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False">
                            <ui:Ico x:Name="MicIco" Data="{StaticResource IcoMic}" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="Timecode" Text="00:00:00" FontFamily="{StaticResource PlexLight}" FontSize="34" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                            <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <ContentControl x:Name="RecordKeys" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- right column -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-6,0" Padding="0,0,6,0">
                <StackPanel>
                    <!-- source -->
                    <Border CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="{core:L src.screen}" x:Name="SourceTitle"/>
                            <ui:Segments x:Name="SourceSeg"/>
                            <Grid x:Name="SourceBody" Margin="0,12,0,0" MinHeight="118">
                                <!-- screen -->
                                <StackPanel x:Name="ScreenPane">
                                    <Canvas x:Name="MonitorMap" Height="96" ClipToBounds="False"/>
                                    <TextBlock x:Name="MonitorLabel" Style="{StaticResource Dim}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <!-- window -->
                                <Grid x:Name="WindowPane" Visibility="Collapsed">
                                    <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="WindowList"/>
                                    </ScrollViewer>
                                </Grid>
                                <!-- region -->
                                <StackPanel x:Name="RegionPane" Visibility="Collapsed">
                                    <TextBlock x:Name="RegionSize" FontFamily="{StaticResource PlexSemi}" FontSize="22"/>
                                    <TextBlock x:Name="RegionWhere" Style="{StaticResource Dim}" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="DrawRegion" Style="{StaticResource BtnAccent}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:Ico Data="{StaticResource IcoRegion}" Width="16" Height="16" Margin="0,0,7,0"/>
                                                <TextBlock x:Name="DrawRegionText"/>
                                            </StackPanel>
                                        </Button>
                                        <ContentControl x:Name="RegionKeys" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- sound -->
                    <Border CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="{core:L sound}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:Ico Data="{StaticResource IcoSpeaker}" Width="18" Height="18" Foreground="{DynamicResource TextDim}"/>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="{core:L sound.system}"/>
                                    <TextBlock x:Name="SysDeviceText" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <ui:Toggle x:Name="SysToggle" Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="28,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <ui:LevelMeter x:Name="SysMeter" VerticalAlignment="Center"/>
                                <Slider x:Name="SysVolume" Grid.Column="1" Minimum="0" Maximum="2" Margin="10,0,0,0" ToolTip="Volume"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:Ico x:Name="MicRowIco" Data="{StaticResource IcoMic}" Width="18" Height="18" Foreground="{DynamicResource TextDim}"/>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="{core:L sound.mic}"/>
                                    <TextBlock x:Name="MicDeviceText" Style="{StaticResource Faint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <ui:Toggle x:Name="MicToggle" Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="28,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                <ui:LevelMeter x:Name="MicMeter" VerticalAlignment="Center"/>
                                <Slider x:Name="MicVolume" Grid.Column="1" Minimum="0" Maximum="2" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- video -->
                    <Border CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Section}" Text="{core:L video}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ResCombo"/>
                                <ComboBox x:Name="FpsCombo" Grid.Column="2"/>
                            </Grid>
                            <ui:Segments x:Name="QualitySeg" Margin="0,10,0,0"/>
                            <TextBlock x:Name="EncoderLine" Style="{StaticResource Faint}" Margin="0,10,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- takes -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10,16,14">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:Ico Data="{StaticResource IcoFilm}" Width="16" Height="16" Foreground="{DynamicResource TextDim}"/>
                        <TextBlock Text="{core:L takes}" FontFamily="{StaticResource PlexSemi}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TakesCount" Style="{StaticResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="OpenFolder" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:Ico Data="{StaticResource IcoFolder}" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{core:L takes.folder}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Height="112" Margin="0,8,0,0">
                    <ScrollViewer x:Name="TakesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TakesRow" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <TextBlock x:Name="TakesEmpty" Text="{core:L takes.empty}" Style="{StaticResource Faint}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- settings slide over everything below the title bar -->
        <Border x:Name="SettingsHost" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Bg}" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="SettingsMove"/></Border.RenderTransform>
        </Border>
    </Grid>
</Window>
