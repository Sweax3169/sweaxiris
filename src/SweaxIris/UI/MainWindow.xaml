<Window x:Class="SweaxIris.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SweaxIris.UI"
        xmlns:core="clr-namespace:SweaxIris.Core"
        Title="SweaxIris" Width="1120" Height="800" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource Plex}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- a soft light from the lens, behind everything -->
        <Ellipse Grid.RowSpan="3" Width="900" Height="420" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-260,0,0" IsHitTestVisible="False" Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop" Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- title bar: name, pages, window buttons -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <ui:Iris x:Name="Logo" Width="26" Height="26" ShowScale="False" Aperture="0.42"/>
                <TextBlock Text="SweaxIris" FontWeight="SemiBold" FontSize="15.5" Margin="10,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
            <Canvas x:Name="TabsHost" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Height="56">
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="0" Height="56" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Border x:Name="TabMark" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" Canvas.Top="50" Width="40">
                    <Border.RenderTransform><TranslateTransform x:Name="TabMove"/></Border.RenderTransform>
                </Border>
            </Canvas>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="RecChip" CornerRadius="7" Background="{DynamicResource TallySoft}" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="{DynamicResource Tally}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecChipText" Margin="7,0,0,0" FontWeight="Medium" FontSize="12.5"/>
                    </StackPanel>
                </Border>
                <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoMin}" Width="14" Height="14" Stroke="1.3"/></Button>
                <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoMax}" Width="12" Height="12" Stroke="1.3"/></Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseBtn}" WindowChrome.IsHitTestVisibleInChrome="True"><ui:Ico Data="{StaticResource IcoClose}" Width="13" Height="13" Stroke="1.3"/></Button>
            </StackPanel>
        </Grid>

        <!-- pages -->
        <Grid Grid.Row="1">
            <!-- RECORD -->
            <Grid x:Name="RecordPage" Margin="32,6,32,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- step 1: what -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ModeScreen" Grid.Column="0" Style="{StaticResource ModeBtn}" Tag="screen"/>
                    <Button x:Name="ModeWindow" Grid.Column="2" Style="{StaticResource ModeBtn}" Tag="window"/>
                    <Button x:Name="ModeRegion" Grid.Column="4" Style="{StaticResource ModeBtn}" Tag="region"/>
                </Grid>

                <!-- the pictures to choose from -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="PickTitle" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="SearchBox" Width="230" Height="32" CornerRadius="8" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed">
                                <Grid>
                                    <ui:Ico Data="{StaticResource IcoSearch}" Width="15" Height="15" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource TextFaint}"/>
                                    <TextBox x:Name="Search" Margin="28,0,4,0" BorderThickness="0" Background="Transparent" Padding="2,5"/>
                                </Grid>
                            </Border>
                            <Button x:Name="RefreshWindows" Style="{StaticResource IconBtn}" Margin="6,0,0,0" Visibility="Collapsed"><ui:Ico Data="{StaticResource IcoRefresh}" Width="16" Height="16"/></Button>
                        </StackPanel>
                    </Grid>
                    <!-- tiles fill the page width; the scroll bar sits out in the page margin, and the hover lift is not clipped -->
                    <ScrollViewer x:Name="PickScroll" Grid.Row="1" Margin="0,8,-22,0" Style="{StaticResource TileScroll}">
                        <WrapPanel x:Name="Picks" Orientation="Horizontal" Margin="6,6,-30,0"/>
                    </ScrollViewer>
                    <!-- while recording: the program picture, large -->
                    <Border x:Name="LiveView" Grid.RowSpan="2" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource Viewfinder}" BorderBrush="{DynamicResource Tally}" BorderThickness="2" Visibility="Collapsed">
                        <Grid>
                            <Image x:Name="LivePicture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border x:Name="LiveChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" CornerRadius="6" Background="{DynamicResource Tally}" Padding="9,4,11,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LiveText" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="LiveNote" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,12" FontSize="12" Foreground="#CCFFFFFF"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- step 2: sound and picture, on one deck -->
                <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource Deck}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,14"/>
                    <Border Grid.Column="3" Background="{DynamicResource Line}" Margin="0,14"/>
                    <!-- system sound -->
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="SysToggle" Style="{StaticResource ChannelBtn}"><ui:Ico x:Name="SysIco" Data="{StaticResource IcoSpeaker}" Width="20" Height="20"/></ToggleButton>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{core:L sound.system}" FontWeight="SemiBold" FontSize="13.5"/>
                                <ComboBox x:Name="SysDevice" Style="{StaticResource LinkCombo}"/>
                            </StackPanel>
                            <TextBlock x:Name="SysPct" Grid.Column="2" Style="{StaticResource Dim}" VerticalAlignment="Center" FontSize="12.5"/>
                            <ui:Fader x:Name="SysFader" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <!-- microphone -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MicToggle" Style="{StaticResource ChannelBtn}"><ui:Ico x:Name="MicRowIco" Data="{StaticResource IcoMic}" Width="20" Height="20"/></ToggleButton>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{core:L sound.mic}" FontWeight="SemiBold" FontSize="13.5"/>
                                <ComboBox x:Name="MicDevice" Style="{StaticResource LinkCombo}"/>
                            </StackPanel>
                            <TextBlock x:Name="MicPct" Grid.Column="2" Style="{StaticResource Dim}" VerticalAlignment="Center" FontSize="12.5"/>
                            <ui:Fader x:Name="MicFader" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <!-- picture -->
                    <Border Grid.Column="4" Style="{StaticResource Panel}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{core:L set.res}" Style="{StaticResource Faint}" Margin="2,0,0,4"/><ComboBox x:Name="ResCombo"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{core:L set.fps}" Style="{StaticResource Faint}" Margin="2,0,0,4"/><ComboBox x:Name="FpsCombo"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="{core:L set.rate}" Style="{StaticResource Faint}" Margin="2,0,0,4"/><ComboBox x:Name="QualityCombo"/></StackPanel>
                            </Grid>
                            <Grid Margin="2,10,0,0">
                                <TextBlock x:Name="EncoderLine" Style="{StaticResource Faint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                                <Button x:Name="MoreVideo" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" Content="{core:L more.settings}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </Grid>

            <!-- LIBRARY -->
            <Grid x:Name="LibraryPage" Margin="32,10,32,18" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{core:L takes}" FontWeight="SemiBold" FontSize="20"/>
                        <TextBlock x:Name="TakesCount" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="OpenFolder" Style="{StaticResource Btn}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:Ico Data="{StaticResource IcoFolder}" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:L takes.folder}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,-22,0" Style="{StaticResource TileScroll}">
                    <WrapPanel x:Name="TakesRow" Margin="6,6,-30,0"/>
                </ScrollViewer>
                <StackPanel x:Name="TakesEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:Iris Width="96" Height="96" ShowScale="False" Aperture="0.1"/>
                    <TextBlock Text="{core:L takes.empty}" Style="{StaticResource Dim}" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- SETTINGS -->
            <Border x:Name="SettingsHost" Visibility="Collapsed"/>
        </Grid>

        <!-- the record strip -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,14,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- the chosen source, live -->
                <Border Width="128" Height="72" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource Viewfinder}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Uniform"/>
                        <ui:Ico x:Name="PreviewIco" Data="{StaticResource IcoScreen}" Width="26" Height="26" Foreground="#606976"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StripDot" Width="9" Height="9" Fill="{DynamicResource Tally}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="StripTitle" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="StripSub" Style="{StaticResource Dim}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Timecode" Text="00:00:00" FontWeight="Light" FontSize="30" VerticalAlignment="Center" Margin="0,0,18,2" Visibility="Collapsed"/>
                    <Button x:Name="PauseButton" Style="{StaticResource Btn}" Height="52" Padding="16,0" Margin="0,0,8,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:Ico x:Name="PauseIco" Data="{StaticResource IcoPause}" Width="18" Height="18" Stroke="2.2"/>
                            <TextBlock x:Name="PauseText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MicButton" Style="{StaticResource Btn}" Width="52" Height="52" Padding="0" Margin="0,0,8,0" Visibility="Collapsed">
                        <ui:Ico x:Name="MicIco" Data="{StaticResource IcoMic}" Width="19" Height="19"/>
                    </Button>
                    <!-- record / stop: the iris and its words -->
                    <Border x:Name="RecordHost" Height="64" MinWidth="236" CornerRadius="14" Cursor="Hand" Padding="8,0,20,0"
                            Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Border.RenderTransform><ScaleTransform x:Name="RecordScale"/></Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid Width="54" Height="54">
                                <ui:Iris x:Name="RecordIris" ShowScale="False" Aperture="0.2"/>
                                <TextBlock x:Name="CountText" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="20" Foreground="White" Opacity="0" IsHitTestVisible="False"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="RecordWord" FontWeight="SemiBold" FontSize="17"/>
                                <ContentControl x:Name="RecordKeys" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
